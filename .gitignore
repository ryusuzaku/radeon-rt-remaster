# Build output. Never commit build trees, generated binaries or CMake caches.
/build/
build/
*.obj
*.lib
*.exe
*.dll
*.pdb
*.ilk
*.exp
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Capture, replay and diagnostic artifacts. These can embed extracted game
# content, so they are never committed: the project's rule is that no original
# game asset is redistributed.
*.rrt.jsonl
*.pixels
*.rrscene
*.rrinputs
*.rrcapture
*.rrmat
*.signals
*.log

# Python.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# AI assistant working data. Session transcripts, task state and memory are
# local to the author's machine and are not part of the project.
.workbuddy-ai/
.reasonix/
.claude/
.cursor/
.aider*
.copilot/

# Session working logs. These are the assistant's running record of a
# development session rather than project documentation, and they carry operator
# notes and machine paths. They stay on disk and out of the published tree;
# docs/ carries the durable project record.
HANDOFF.md
progress.md
findings.md
task_plan.md

# Local workflow shell-check scratch (see the gha-embedded-shell-check skill).
.gha-shell-check/

# Editor and OS.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
